/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "sdm660.dtsi"
#include "pm660.dtsi"
#include "pm660l.dtsi"

/ {
	model = "ASUS Zenfone Max Pro M2 (X01BD)";
	compatible = "asus,x01bd", "qcom,sdm660";
	chassis-type = "handset";

	qcom,msm-id = <317 0x0>;
	qcom,board-id = <0x1000b 0x0>;
	qcom,pmic-id = <0x1001b 0x101011a 0x0 0x0
			0x1001b 0x201011a 0x0 0x0>;

	aliases {
		serial0 = &blsp1_uart2;
		mmc0 = &sdhc_1;
		mmc1 = &sdhc_2;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		framebuffer@9d400000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x9d400000 0x0 (1080 * 2280 * 4)>;
			width = <1080>;
			height = <2280>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x0>;
	};

	reserved-memory {
		splash_region: memory@9d400000 {
			reg = <0x0 0x9d400000 0x0 0x2400000>;
			no-map;
		};

		ramoops@9ff00000 {
			compatible = "ramoops";
			reg = <0x0 0x9ff00000 0x0 0x100000>;
			console-size = <0x40000>;
			pmsg-size = <0x40000>;
			record-size = <0x20000>;
			no-map;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_keys_default>;

		key-volume-up {
			label = "Volume Up";
			gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <15>;
			wakeup-source;
		};
	};
};

&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm660-regulators";

		vreg_pm660_l8: l8 {
			regulator-min-microvolt = <1750000>;
			regulator-max-microvolt = <1900000>;
		};

		vreg_pm660_l10: l10 {
			regulator-min-microvolt = <1780000>;
			regulator-max-microvolt = <1950000>;
		};

		vreg_pm660_l11: l11 {
			regulator-min-microvolt = <1780000>;
			regulator-max-microvolt = <1950000>;
		};
	};

	regulators-1 {
		compatible = "qcom,rpm-pm660l-regulators";

		vreg_pm660l_l1: l1 {
			regulator-min-microvolt = <800000>;
			regulator-max-microvolt = <925000>;
		};

		vreg_pm660l_l2: l2 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2950000>;
		};

		vreg_pm660l_l3: l3 {
			regulator-min-microvolt = <1710000>;
			regulator-max-microvolt = <3600000>;
			regulator-always-on;
		};

		vreg_pm660l_l4: l4 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <2950000>;
		};

		vreg_pm660l_l5: l5 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
		};

		vreg_pm660l_l7: l7 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3125000>;
			regulator-always-on;
		};
	};
};

&tlmm {
	uart_console_default: uart-console-default-state {
		pins = "gpio4", "gpio5";
		function = "blsp_uart2";
		drive-strength = <2>;
		bias-disable;
	};

	vol_keys_default: vol-keys-default-state {
		pins = "gpio43", "gpio44";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&blsp1_uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart_console_default>;
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

&qusb2phy0 {
	vdd-supply = <&vreg_pm660l_l1>;
	vdda-pll-supply = <&vreg_pm660_l10>;
	vdda-phy-dpdm-supply = <&vreg_pm660l_l7>;
	status = "okay";
};

&sdhc_1 {
	vmmc-supply = <&vreg_pm660l_l4>;
	vqmmc-supply = <&vreg_pm660_l8>;
	status = "okay";
};

&sdhc_2 {
	vmmc-supply = <&vreg_pm660l_l5>;
	vqmmc-supply = <&vreg_pm660l_l2>;
	cd-gpios = <&tlmm 54 GPIO_ACTIVE_LOW>;
	status = "okay";
};